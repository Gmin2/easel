# Copy to .env and fill in whichever you have. Everything degrades: with no
# keys at all the image path still works through a keyless fallback, and the
# model chip only offers what the keys on this deployment can actually do.
#
# These names are deliberately unprefixed, so Vite cannot bundle them into the
# client. They are read only inside api/ — on Vercel as function environment
# variables, and locally by the dev-server middleware in vite.config.ts.
# Restart the dev server after editing this file.

# Text to design (HTML + CSS). Any one of these three is enough; the model chip
# offers each that is present, plus a variety pack that fires them all at once.
OPENAI_API_KEY=
KIMI_API_KEY=

# Text to image. Without this the image path falls back to keyless Pollinations
# and says so in the UI. Also serves as a text and SVG model.
GEMINI_API_KEY=

# Text to SVG, via QuiverAI Arrow (arrow-1.1 by default).
# Quiver's own docs call this QUIVERAI_API_KEY; either name is read.
QUIVER_API_KEY=

# ---------------------------------------------------------------- optional
# Pin a model instead of using the default. Only set these if you know you
# want to; the defaults are chosen to work.
# OPENAI_MODEL=gpt-5.1
# KIMI_MODEL=kimi-k2.6
# GEMINI_TEXT_MODEL=gemini-flash-latest
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# Point a client at a compatible endpoint elsewhere.
# OPENAI_BASE_URL=https://api.openai.com/v1
# KIMI_BASE_URL=https://api.moonshot.ai/v1
